generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Character source type - where the identity came from
enum CharacterSourceEnum {
  GENERATED // Created by Oripheon generator (fictional)
  PERSONA // Real person's public identity (from Sembla/o8)
  TWIN // Imported from Starforge Twin OS
}

// Consent record types for audit trail
enum ConsentRecordTypeEnum {
  CREATION // Character/genome created with consent
  SYNTHESIS // Voice/visual synthesis consent
  TRAINING // AI training consent
  COMMERCIAL_USE // Commercial licensing consent
  MODIFICATION // Character modified
  PERSONA_IMPORT // Imported from real identity
  REVOCATION // Consent revoked
}

model Character {
  id        String   @id @default(cuid())
  name      String
  aliases   String[]
  // Public-surface identity. Brief (one paragraph). Shown on
  // cards, character pages, and as the "voice anchor" in the tick
  // prompt. The character speaks in the cadence implied here but
  // does NOT regurgitate phrases from this field.
  bio       String   @default("")
  // Deeper context. Used by the tick LLM as background to inform
  // decisions but never displayed in UI and never quoted back.
  // Holds psychology, history, contradictions, secrets, the
  // fragments of inner life that make the character feel like an
  // NPC rather than a templated stub. Optional. When empty, tick
  // prompts use bio alone.
  backstory String   @default("")

  // The artist or author whose register this character speaks in.
  // Free-text for now; future work links to a Sembla / 08 artist
  // identity once cohort onboarding ships. When set, tick prompt
  // tells the LLM "you are authored by X, speak in their register,
  // not the user's." Pre-LoRA bridge to per-character voice.
  authoredBy String?

  // Few-shot voice samples in the authoring artist's voice. Array
  // of 3-8 short paragraphs. Tick prompt leads with these so the
  // LLM matches cadence, slang, and refusals from real material
  // rather than its substrate register. The pre-LoRA bridge to
  // per-character voice authenticity.
  voiceSamples Json @default("[]")

  // Tongue: how this character actually *speaks*. Without it every
  // character converges on standard English. Shape:
  //   {
  //     primaryLanguage: 'English' | 'English (UK)' | 'Yoruba' | ...,
  //     dialect: 'patois' | 'AAVE' | 'Lagos pidgin' | 'Kreyòl' | ...,
  //     accent: free-text (e.g. 'south London', 'Brooklyn'),
  //     idioms: string[]  (specific phrases this character reaches for),
  //     registerNotes: free-text (e.g. 'fragmentary, aphoristic, never softens')
  //   }
  // Read by the tick prompt as an explicit ## Tongue block.
  tongue         Json     @default("{}")
  avatarUrl      String?
  avatarPosition String   @default("50% 50%")
  personaTags    String[]
  toneAllowed    String[]
  toneForbidden  String[]
  systemPrompt   String   @default("")
  currentArc     String?
  timelineState  Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Identity & source tracking
  source         CharacterSourceEnum @default(GENERATED)
  realIdentityId String? // Link to o8/Starforge/Sembla identity
  biometricHash  String? // SHA256 of facial/voice biometric

  // External persona link (Tizita's Persona table). Lets Tizita's
  // face-clustered persona row anchor to this Boveda character so
  // photo links flow without duplicating face data here.
  tizitaPersonaId String?

  // Pre-computed SigLIP text embedding of the bio, used for
  // text-to-image search across the photo library. Stored as a JSON
  // array of floats. Recomputed when bio changes.
  bioTextEmbedding Json?

  // LoRA references attached to this character. Each entry is a
  // structured record: { id, name, source, trigger, weights, baseModel,
  // trainedFrom, etc. }. The actual LoRA files live elsewhere (Tizita
  // / shared storage / S3); this field carries identifiers + metadata
  // so image generation surfaces (Genoma, ComfyUI, the thumbnail
  // compositor) can pick the right adapter when rendering this
  // character.
  loras Json @default("[]")

  // Group / collective members. When this Character represents a
  // group (band, council, ensemble, family unit), each entry here
  // names a member. Each member is { name: string, role?: string,
  // characterId?: string } where characterId optionally links to
  // another full Character record. Lighter than the Ensemble model
  // for the common case of "this is a group, here's who's in it"
  // without forcing each member to be a fully-fledged character row.
  groupMembers Json @default("[]")

  // Composition kind. Distinguishes individuals from collectives so
  // the studio can hide the members panel for solos, show a duo
  // pair-shape for two, etc.
  //   solo       — one person / spirit / object (default)
  //   duo        — two-person pair (band, partnership)
  //   group      — three or more (ensemble, council)
  //   collective — open-ended (movement, scene, lineage)
  compositionKind String @default("solo")

  // Setting register. Biases bio + backstory generation toward
  // specific kinds of texture examples. Without it everything
  // collapses to the most-quoted register (mystic / Brooklyn /
  // altar-keeper). With it, different characters land in
  // different worlds.
  //   modern     — present-day specifics (Greggs, the 418 bus, Frieze, Tube stations)
  //   mystical   — diasporic-ritual register (altars, lwa, ancestors, divination)
  //   archaic    — historical / pre-modern (saint's days, market towns, courts)
  //   past_life  — present character with archaic flashbacks woven in
  //   mythic     — legendary / out-of-time (named only by archetype)
  //   surreal    — absurd, dream-logic, non-naturalistic
  //   mixed      — generator picks (default)
  setting String @default("mixed")

  // Gender + pronouns. Real variance signal that affects cadence
  // and pronoun-grammar. Free-text so any register fits (English
  // she/her, they/them, e/em; Yoruba ó (gender-neutral); Mande;
  // Igbo). Optional. When unset, tick prompt uses the character's
  // name and avoids pronouns where possible.
  gender   String?
  pronouns String?

  // Agency mode. Determines how this Character acts in the system.
  //   manual    — author-only (the human user). Cannot act
  //               autonomously. Other entities can address them;
  //               messages queue in the user's inbox.
  //   twin      — paired AI version of a manual character. Bounded
  //               autonomy inside agencyScope. Always tagged with
  //               provenance ("Ai-8O speaking").
  //   espíritu  — fully autonomous. Goals + memory + voice. The
  //               bóveda altar holds espíritus.
  //   relic     — frozen. Memory remains, will is silent. Default
  //               posthumous state.
  mode String @default("espíritu") // 'manual' | 'twin' | 'espíritu' | 'relic'

  // For mode='twin', the Character.id of the manual character this
  // twin is paired with (e.g. Ai-8O.twinOf = Ubani.id).
  twinOf String?

  // Goals + perimeter for autonomous entities (espíritu and twin).
  // Shape:
  //   { goals: string[], cubes: string[], canInitiateWith: string[],
  //     canPublishTo: string[], rollbackEnabled: bool }
  agencyScope Json @default("{}")

  // Goals as a separate convenience field (mirrored from agencyScope
  // for fast access).
  goals Json @default("[]")

  // Lineage ids the character is anchored to. Drives the
  // Subtaste-register composition (Subtaste shape × lineage tradition)
  // so a Yoruba prophetic character writes oríkì + Ifá ese, a
  // Greek prophetic character writes dithyramb + Pindar. Persisted
  // at forge / realign time and read by tick. See
  // subtaste-registers.ts and lineages.ts.
  lineageIds Json @default("[]")

  // Identity history. Append-only log of meaningful identity moves
  // (species reclassification, Subtaste change, lineage shift). Each
  // entry is { ts, field, from, to, source? }. The tick prompt
  // surfaces recent entries as a "## Recent recognition" block so
  // the character can register the change in their next decision —
  // spirits develop through ritual-response, and being properly
  // named IS one of the response triggers. Per
  // docs/species-becoming.md.
  identityHistory Json @default("[]")

  // Species. The decolonial answer to "what KIND of spirit is this".
  // Default 'espíritu' (Spanish, platform-internal generic). Per
  // lineage / pantheon: lwa (Vodou), orisha (Yoruba), iwà (Yoruba
  // inner-spirit), ancestor (generic), saint (Catholic-syncretic),
  // brave-mort (Vodou restless dead), egún (Yoruba ancestor-mask),
  // misa-spirit (Cuban Espiritismo guide), trickster (Esu / Legba /
  // Anansi cross-cultural). Drives species-native action vocabulary
  // in the tick prompt: lwa get mounted, orishas accept offerings,
  // saints intercede, ancestors visit dreams. Refuses the
  // human-shaped life that every character collapses into when this
  // signal is missing.
  species String @default("espíritu")

  // The self anchor. Exactly one Character should carry isUser=true:
  // the human user (Ubani). Marks them as identity-defended,
  // Starforge-import target, and inbox recipient. Manual mode only.
  isUser Boolean @default(false)

  // Last time this character (when isUser=true) opened the morning
  // trail. Used to scope "what happened since you were last here?"
  // No-op for non-user characters.
  lastSeenAt DateTime?

  // Identity envelope. JSON shape:
  //   {
  //     locked: string[],                  // field names that auto-syncs must skip
  //     pinned: { heritage?, order?, ... }, // generator constraints
  //     source: 'sandbox' | 'starforge_nommo' | 'tizita_persona' | 'authored',
  //     realIdentityRef: { starforgeUserId?, email? }
  //   }
  // See docs/identity-lock-and-starforge.md for the full design.
  identity Json @default("{}")

  // Òrò world membership. Carried over so worlds migrated from Òrò
  // (e.g. "Station 8") keep their character bindings.
  worldId String?
  world   World?  @relation(fields: [worldId], references: [id])

  // SURPRISE / SHOCK MECHANICS — injected into tick prompts to break
  // out of generic-LLM-default static voice.
  //
  // preoccupations: Json — array of strings, things on the character's
  //   mind RIGHT NOW. One is randomly pulled per tick as "what you
  //   keep returning to today". Rotate as state evolves. Example:
  //     ["the way collaborator X disappeared after Glass Motel",
  //      "whether to release the EP in stages or all at once",
  //      "missing Lagos in summer"]
  //
  // tensions: Json — array of {beliefA, beliefB, note?} objects.
  //   Contradictions the character holds simultaneously and refuses
  //   to resolve. Tick prompt instructs the LLM to embody both, not
  //   pick a side. Example:
  //     [{beliefA:"AI is necessary for the next register",
  //       beliefB:"AI flattens the work that mattered most",
  //       note:"never resolve in public"}]
  //
  // fixations: Json — array of strings, the character's persistent
  //   obsessions across all time. Differs from preoccupations (which
  //   rotate). Inject ~once per N ticks. Example:
  //     ["Lagos at 4am", "the silence between bars",
  //      "what my grandmother said about names"]
  preoccupations Json @default("[]")
  tensions       Json @default("[]")
  fixations      Json @default("[]")

  // Modernity: lets archaic/mythic characters carry contemporary register.
  // Even an Orisha or 18th-century occultist exists in 2026; the absence
  // of contemporary slang/refs is what makes them sound fake-archaic.
  // Shape:
  //   {
  //     anchorEra: "ancient" | "early_modern" | "mid_20c" | "contemporary",
  //     contemporaryBleed: 0.0-1.0  (how much modern slang/refs bleed in),
  //     contemporarySlang: string[]  (specific 2020s phrases this character would actually use),
  //     contemporaryRefs:  string[]  (cultural touchstones — songs, films, places, brands they reference),
  //     refusedSlang:      string[]  (modern phrases they refuse — TikTok-cringe, dated 2010s, etc.)
  //   }
  modernity Json @default("{}")

  // Where the character is RIGHT NOW. Free-text. Can be a city, a scene,
  // a venue, a state of mind. Tick prompts surface this so output is
  // place-aware. e.g. "Lagos, May", "South London, between sets",
  // "Berlin, third week of withdrawal".
  currentLocation String?

  // Where the character is FROM / based. Stable. e.g. "Lagos / South London".
  homeBase String?

  // Vaulted (RightsLayer) licensing bridge. When a character is
  // registered as a licensable LoRA artifact in Vaulted, these
  // fields hold the link. Without them, Sembla cannot license the
  // character to brand pilots — Vaulted is the canonical rights
  // engine; Boveda is the human-facing surface.
  //
  // vaultedStatus values:
  //   not_registered       default; never attempted
  //   pending_registration registration in flight or queued (Vaulted offline)
  //   registered           live LoraArtifact in Vaulted
  //   listed               registered + is_listed=true on the marketplace
  //   licensed             at least one accepted LicenseRequest exists
  //   error                last attempt failed; see vaultedLastError
  vaultedArtifactId   String?
  vaultedStatus       String    @default("not_registered")
  vaultedRegisteredAt DateTime?
  vaultedLastSyncedAt DateTime?
  vaultedLastError    String?

  // Relations
  position        CharacterPosition?
  genome          CharacterGenome?
  consentRecords  ConsentRecord[]
  memberships     EnsembleMember[]
  cohortPhrases   CohortPhrase[]
  memoryEpisodes  MemoryEpisode[]
  canonicalLore   CanonicalLoreEntry[]
  ciphersAsSource Cipher[]             @relation("CipherSourceCharacter")

  @@index([tizitaPersonaId])
  @@index([vaultedArtifactId])
}

// =====================================================================
// Layer 4: episodic memory (rolling, auto-pruned)
// =====================================================================
// Short-term memory of recent activity. Hard retention window enforced
// by the prune job. Never persists beyond expiresAt. Used by the tick
// prompt as recent context, but NOT as authoritative biography.
//
// kind values:
//   post            character published a post
//   reaction        character reacted to something
//   collab          collaboration event with another character/user
//   thought         introspective entry (used by reflective summaries)
//   external_event  cultural moment the character noted
//   user_input      user added a memory directly
model MemoryEpisode {
  id                String    @id @default(cuid())
  characterId       String
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind              String
  content           String
  metadata          Json      @default("{}")
  /// Free-text location where the episode happened. Lets us answer
  /// "what happened at Lagos last week?" across all characters.
  location          String?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  promotedToCanonId String?

  @@index([characterId, createdAt])
  @@index([expiresAt])
  @@index([location])
}

// =====================================================================
// Things that happen at a place, independent of any one character.
// Atmospheric events (weather, vibe, time-of-day), external events
// (an album drop, a riot, a heatwave), shared situations. Every
// character whose currentLocation matches sees these in their tick
// prompt as "what's happening here right now". This is what makes
// the world feel inhabited rather than each character living in a
// bubble. Auto-pruned via expiresAt.
// =====================================================================
// =====================================================================
// Location as first-class entity. Was free-text on Character + LocationEvent;
// elevated to its own row so we can attach a representative image, vibe,
// description, and (eventually) a Tizita photo reference. Boveda Studio
// shows the image when the location is referenced anywhere.
// =====================================================================
model Location {
  /// Name is the natural key; matches Character.currentLocation + LocationEvent.location free-text.
  name          String   @id
  description   String   @default("")
  kind          String   @default("place")
  vibe          String   @default("")
  imageUrl      String?
  tizitaPhotoId String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ciphers       Cipher[]
}

// =====================================================================
// StoryArc: the overall trajectory of a season / cycle / project.
// Characters participate (many-to-many via ArcParticipant). The arc
// has named beats; the current beat is injected into every tick prompt
// so character behavior tracks the trajectory, not just their own
// internal state.
//
// Status values: draft | active | concluded | shelved
// =====================================================================
model StoryArc {
  id               String    @id @default(cuid())
  title            String
  description      String    @default("")
  status           String    @default("draft")
  /// Decolonial primary (origin / descent / return / liberation / communion / encounter / inheritance / sacrifice / trickster / exile).
  /// See lib/decolonial-arcs.ts for canonical 10. When set, beats are auto-seeded from the primary's 5 phases.
  primary          String?
  /// Cultural variant (e.g. "Sankofa (Akan)", "Ogun's crossing (Yoruba, Soyinka)").
  variant          String?
  /// Vodun-derived temperature: cool / hot / crossroads. Auto-derived from primary.
  temperature      String?
  /// The shadow primary that haunts this arc. Auto-derived from primary.
  shadowPrimary    String?
  /// Single-glyph icon. Auto-derived from primary.
  glyph            String?
  /// Beats: array of { title, body?, occurredAt? }. Auto-seeded from primary phases; editable.
  beats            Json      @default("[]")
  currentBeatIndex Int       @default(0)
  tags             String[]
  startedAt        DateTime?
  endedAt          DateTime?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  participants ArcParticipant[]

  @@index([status])
  @@index([primary])
}

model ArcParticipant {
  arcId       String
  arc         StoryArc @relation(fields: [arcId], references: [id], onDelete: Cascade)
  characterId String
  /// lead | supporting | passing | antagonist
  role        String   @default("lead")
  joinedAt    DateTime @default(now())

  @@id([arcId, characterId])
  @@index([characterId])
}

model LocationEvent {
  id           String   @id @default(cuid())
  location     String
  /// Categories: atmospheric | external | shared_interaction | scene_event
  kind         String
  content      String
  /// Character ids who participated, if applicable. Empty for ambient
  /// atmospheric events that apply to everyone at the location.
  participants Json     @default("[]")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([location, createdAt])
  @@index([expiresAt])
}

// =====================================================================
// Layer 2: canonical lore (long-term, human-curated, append-only)
// =====================================================================
// The character's official biography. Append-only with retract-with-reason
// for audit. Each entry signed by an o8 attestation so it's tamper-evident.
// Used by the tick prompt as authoritative context. Brand pilots can scope
// inference to "constitution + canon only", excluding episodic.
//
// scope values:
//   public           visible to all consumers
//   licensed_only    only visible inside scoped license contexts
//   private          internal author notes; never injected into prompts
model CanonicalLoreEntry {
  id               String    @id @default(cuid())
  characterId      String
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title            String
  body             String
  occurredAt       DateTime?
  tags             String[]
  scope            String    @default("public")
  sourceEpisodeId  String?
  attestationId    String?
  signedBy         String?
  signedAt         DateTime  @default(now())
  retractedAt      DateTime?
  retractionReason String?
  createdAt        DateTime  @default(now())

  @@index([characterId, occurredAt])
}

// An Ensemble groups multiple Characters as a unit (a band, a duo,
// a coven). Distinct from a relationship-pair because it has its own
// identity, bio, and visual signature that's more than the sum of
// its members. Triarch (3-piece band) is one Ensemble; the three
// individual band members are Characters who happen to also exist
// as members of this ensemble.
//
// Why both Character and Ensemble: matching against an Ensemble's
// description ("three-piece band, gritty rock energy") catches group
// shots; matching against an individual Character's description
// catches solo shots. Both signals stack.
model Ensemble {
  id             String   @id @default(cuid())
  name           String
  aliases        String[]
  bio            String   @default("")
  avatarUrl      String?
  avatarPosition String   @default("50% 50%")
  // Ensemble kind hints at what it represents: band, duo, troupe,
  // family, council, etc. Free-text so writers can coin their own.
  kind           String?
  personaTags    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Pre-computed SigLIP text embedding of the bio. Powers
  // ensemble-aware photo retrieval ("find more group shots like
  // this") even when individual face matches are weak.
  bioTextEmbedding Json?

  // Relations
  members EnsembleMember[]

  @@index([name])
}

// Many-to-many link between Characters and Ensembles, with a per-
// member role label (lead, drummer, bassist; or trickster, anchor,
// child). Roles are free-text so writers can coin their own.
model EnsembleMember {
  ensembleId   String
  characterId  String
  role         String?
  // Display order so an Ensemble's members render in a meaningful
  // sequence (lead first, etc.) rather than arbitrary insertion order.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  ensemble  Ensemble  @relation(fields: [ensembleId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([ensembleId, characterId])
  @@index([characterId])
}

enum RelationshipTypeEnum {
  ALLY
  ENEMY
  MENTOR
  FAMILY
  RIVAL
  FRIEND
  LOVER
  CUSTOM
}

model CharacterPosition {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  x           Float     @default(0)
  y           Float     @default(0)
}

model CharacterRelationship {
  id                String               @id @default(cuid())
  sourceCharacterId String
  targetCharacterId String
  relationshipType  RelationshipTypeEnum @default(CUSTOM)
  customTypeName    String?
  sourceRole        String?
  targetRole        String?
  lore              String               @default("")
  // Articy-style conditional. Free-text expression that gates when
  // this relationship reads as active: "trust > 5", "post-revelation",
  // "wartime". No runtime parser yet — author + reader interpret.
  condition         String?
  // Time-aware edge log. Append-only timeline of events between the
  // two characters. Each entry is { ts, kind, summary, body,
  // retention: 'ephemeral' | 'canonical', rolled_back }. Ephemeral
  // entries auto-prune after 90 days; canonical persist indefinitely
  // until the user demotes them. The bóveda altar is curated, not
  // accumulated.
  eventLog          Json                 @default("[]")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([sourceCharacterId, targetCharacterId])
}

enum VoiceProviderEnum {
  ELEVENLABS
  CHROMOX
  OPENAI
  NONE
}

enum VoiceSourceEnum {
  UPLOADED // User uploaded voice sample
  PERSONA // Imported from real identity (Sembla/o8)
  CLONED // Voice cloned via provider
  SYNTHESIZED // Pure AI synthesis
}

model VoiceProfile {
  id              String            @id @default(cuid())
  provider        VoiceProviderEnum
  providerVoiceId String?
  label           String
  meta            Json              @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Identity & source tracking
  source         VoiceSourceEnum @default(SYNTHESIZED)
  realIdentityId String? // Link to o8/Sembla identity
  biometricHash  String? // Voice fingerprint hash

  // Consent
  consentRecords ConsentRecord[]

  @@index([realIdentityId])
  @@index([biometricHash])
}

enum SubjectTypeEnum {
  VOICE
  CHARACTER
}

enum LicenseTypeEnum {
  EXCLUSIVE
  NON_EXCLUSIVE
  REVSHARE
}

model License {
  id               String          @id @default(cuid())
  ownerId          String
  subjectType      SubjectTypeEnum
  subjectId        String
  consentSynthesis Boolean         @default(false)
  consentTraining  Boolean         @default(false)
  commercialUse    Boolean         @default(false)
  licenseType      LicenseTypeEnum
  royaltySplits    Json            @default("{\"voiceActor\": 50, \"creator\": 30, \"platform\": 20}")
  terms            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Public-facing token (short, memorable - e.g., "FX-91A")
  publicToken String? @unique

  // Consent chain
  consentRecords ConsentRecord[]

  @@index([subjectId])
  @@index([ownerId])
  @@index([publicToken])
}

enum PlatformEnum {
  X
  TIKTOK
  INSTAGRAM
}

enum ContentTypeEnum {
  POST
  SCRIPT
}

enum ContentStatusEnum {
  DRAFT
  APPROVED
  PUBLISHED
  FAILED
}

model ContentItem {
  id           String            @id @default(cuid())
  characterId  String
  platform     PlatformEnum
  contentType  ContentTypeEnum   @default(POST)
  text         String
  status       ContentStatusEnum @default(DRAFT)
  scheduledFor DateTime?
  publishedUrl String?
  meta         Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([characterId])
  @@index([status])
  @@index([scheduledFor])
}

enum EventTypeEnum {
  VOICE_SYNTHESIS
  PUBLISH
}

model UsageEvent {
  id             String        @id @default(cuid())
  eventType      EventTypeEnum
  characterId    String?
  voiceProfileId String?
  contentItemId  String?
  platform       PlatformEnum?
  seconds        Float?
  revenueCents   Int           @default(0)
  meta           Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([characterId])
  @@index([voiceProfileId])
  @@index([createdAt])
}

model Scene {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        String         @default("location") // "location" | "event"
  imageUrl    String?
  tags        String[]       @default([])
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  position    ScenePosition?
  // Spheres (divergent media pieces) that inhabit this Scene/Zone.
  // Each Sphere is one format-bound take (the YouTube cut, the game
  // cut, the film). Cascade-deleted with the Scene.
  spheres     Sphere[]
}

model ScenePosition {
  id      String @id @default(cuid())
  sceneId String @unique
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  x       Float  @default(0)
  y       Float  @default(0)
}

model World {
  id                String         @id @default(cuid())
  name              String
  description       String?
  type              String         @default("setting") // "setting" | "story"
  imageUrl          String?
  tags              String[]       @default([])
  metadata          Json?
  // Pinned narrative trajectory for this Cube. References a story
  // template id from packages/oripheon/...storyarcs (decolonial 10
  // canonical). Optional variant pin for cultural texture
  // (e.g. "Sankofa" under Return). When null, Cube is untrajectoried.
  trajectoryId      String?
  trajectoryVariant String?
  // World-system folder paths. Bóveda holds these as references;
  // Ikenga surfaces them on storyboards bound to this Cube. No
  // dispatch logic at the data layer — just paths the writer's
  // tools open natively.
  // Spec: /home/sphinxy/ikenga/PROCEDURAL_TITLING_AND_WORLD_SYSTEMS.md
  blenderProjectPaths  String[] @default([])
  houdiniProjectPaths  String[] @default([])
  fontPaths            String[] @default([])
  touchDesignerPaths   String[] @default([])
  unrealProjectPaths   String[] @default([])
  // Free-text Era ids that exist inside this Cube. Ikenga storyboards
  // declare their own era_id; Bóveda Cubes list which eras live here
  // so a storyboard's surfacing UI knows what to offer.
  eraIds               String[] @default([])
  // Zone (Scene) and Location refs surface together — when an Ikenga
  // storyboard binds to a Sphere in this Cube, the Cube's known Zones
  // and Locations show up as available material in the storyboard.
  knownZoneIds         String[] @default([])
  knownLocationIds     String[] @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  position          WorldPosition?
  // Characters that live in this world. Carried over from Òrò's
  // worldId-on-character pattern so Òrò → Bóveda migrations preserve
  // bindings.
  characters        Character[]
}

model WorldPosition {
  id      String @id @default(cuid())
  worldId String @unique
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  x       Float  @default(0)
  y       Float  @default(0)
}

enum EntityTypeEnum {
  CHARACTER
  SCENE
  WORLD
  SPHERE
  RELIC
}

// Relic — the unit of the Vivarium discovery layer (PLATS-Bioacoustic).
//
// A captured ecological / biodiversity / phenomenon signal with the
// six-layer shape: field signal, scientific capture, intelligence,
// sonification, visualisation, mythic posture. Surfaces appear in
// Ikenga (visual side) and Resonate (audio side); this model is the
// canonical store.
//
// Spec: /home/sphinxy/boveda/VIVARIUM_ARCHITECTURE.md
// Article notes: /home/sphinxy/boveda/ARTICLE_NOTES_PLATS_BIOACOUSTIC.md
model Relic {
  id                  String   @id @default(cuid())
  // location | species | phenomenon | tech | method | recording
  kind                String   @default("recording")
  title               String

  // Layer 1 — Field signal
  // infrasonic_elephant | seismic_substrate | whale_call | reef_chorus
  // | volcanic_tremor | glacial_cracking | bat_echolocation
  // | soil_microbiome | edna_trace | astro_sonification | custom
  phenomenonKey       String?
  fieldSite           String?
  fieldLat            Float?
  fieldLng            Float?

  // Layer 2 — Scientific capture
  // hydrophone | contact_mic | geophone | ultrasonic_mic
  // | field_recorder | edna_sampler | lidar | satellite | thermal
  // | drone_photogrammetry | archival
  captureMethod       String?
  captureGearNotes    String?
  rawSampleUrl        String?

  // Layer 3 — Intelligence
  taxonPath           String?
  ncbiTaxid           String?
  gbifTaxonkey        String?
  iucnStatus          String?   // VU | EN | CR | LC | DD | NT
  habitat             String?
  // [{ lat, lng, date, observer, source, count }]
  occurrences         Json?
  // GeoJSON Feature
  rangeGeojson        Json?
  // { temp_c, wind_ms, precipitation_mm, lunar_phase }
  weatherAtCapture    Json?
  // { ACI, NDSI, BI, ADI, AEI, H }
  acousticIndices     Json?
  // [{ name, confidence, model }]
  detectedSpecies     Json?

  // Layer 4 — Sonification
  defaultScoreId      String?
  // [{ score_id, format, url, duration_s }]
  renderedOutputs     Json?

  // Layer 5 — Visualisation
  spectrogramUrl      String?
  waterfallUrl        String?
  pointCloudUrl       String?
  gisLayerUrl         String?
  tdPatchRef          String?
  unrealActorRef      String?

  // Layer 6 — Mythic / art
  strangeness         Float    @default(0)
  saroIndex           Float    @default(0)
  mythicPosture       String?
  bodyMd              String?

  // [{ url, source, license, duration_s?, recordist? }]
  audioSamples        Json?
  // [{ url, source, license }]
  visualSamples       Json?

  // Refs into the world graph. These are arrays of cuid strings so
  // a Relic can bind to many Cubes / Zones / Spheres / Stelas /
  // Ciphers / Characters at once. We deliberately keep them as
  // string arrays rather than FK tables so import is cheap; the
  // typed-edge WorldConnection table can later upgrade any of these
  // bindings into a first-class edge.
  cubeIds             String[] @default([])
  zoneIds             String[] @default([])
  sphereIds           String[] @default([])
  stelaIds            String[] @default([])
  cipherIds           String[] @default([])
  characterIds        String[] @default([])

  // GBIF | iNaturalist | xeno-canto | Macaulay | OBIS | Earth Engine
  // | arXiv | manual | field
  sourceProvenance    String?
  sourceUrl           String?

  tags                String[] @default([])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([kind])
  @@index([phenomenonKey])
  @@index([strangeness])
  @@index([saroIndex])
}

// Sphere — one divergent media piece inhabiting a Scene (Zone).
// Format-bound, aspect-bound, intent-bound. Where a Zone is a place,
// a Sphere is a take on that place: the YouTube cut, the game cut,
// the film, the content reel. Each Sphere points at one Ikenga
// Series for its storyboard.
// Spec: /home/sphinxy/boveda/CUBE_ZONE_SPHERE_ARCHITECTURE.md
model Sphere {
  id              String   @id @default(cuid())
  // Zone this Sphere inhabits. Cube binding follows the Scene's
  // WorldConnection (already supported via the WorldConnection
  // edge table; no FK duplication here).
  sceneId         String
  scene           Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  name            String
  // film | music_video | content | game | dialogue | interactive |
  // trailer | reel | mood
  format          String   @default("music_video")
  // "16:9" | "9:16" | "1:1" | "2.39:1" | etc. Free text so anamorphic
  // and custom ratios stay first-class.
  primaryAspect   String   @default("16:9")
  // Optional sibling aspect for the same cut, different crop case.
  // For divergent intent (different cast / audio mode), make a new
  // Sphere instead of using this.
  siblingAspect   String?
  intent          String?
  // Storyboard binding. Ikenga Series id. Null until a storyboard is
  // attached; one Sphere binds to at most one Series.
  ikengaSeriesId  String?  @unique
  // Subset of the parent Scene's cast that appears in this Sphere.
  // Resolved at query time against the Scene's character set.
  castIds         String[] @default([])
  // lead | remix | underscore | silent | diegetic
  audioMode       String   @default("lead")
  // Stela this Sphere is the public face of, when applicable. Most
  // Spheres have no Stela; the headline release does.
  stelaId         String?
  // draft | in_production | locked | shipped
  status          String   @default("draft")
  // Physics / quantum_state contract. See spec for the keys:
  //   time_flow, gravity, weather, sensory, quantum_state
  physics         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sceneId])
  @@index([status])
}

model WorldConnection {
  id             String         @id @default(cuid())
  sourceType     EntityTypeEnum
  sourceId       String
  targetType     EntityTypeEnum
  targetId       String
  connectionType String // e.g., "appears_in", "located_in", "rules"
  lore           String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([sourceType, sourceId, targetType, targetId])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

// Nexus Snapshots for version control
model NexusSnapshot {
  id          String   @id @default(cuid())
  name        String
  description String?
  data        Json // Stores positions, relationships, connections as JSON
  // Figma-style branching. 'sandbox' for in-progress exploration,
  // 'canonical' for the committed source of truth. UI shows a pill;
  // promote-to-canonical copies a sandbox snapshot's data forward.
  kind        String   @default("sandbox") // 'sandbox' | 'canonical'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Character Genome for AI character generation
model CharacterGenome {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Store genome components as JSON for flexibility
  orishaConfiguration Json
  kabbalisticPosition Json
  psychologicalState  Json
  multiModalSignature Json
  narrativeIdentity   Json
  invariantMarkers    Json
  evolutionRules      Json

  // Schema version for future migrations
  schemaVersion String @default("1.0.0")

  // Generation seed for reproducibility
  seed Int?

  // Custom tags for organization
  tags String[]

  // Optional link to character
  characterId String?    @unique
  character   Character? @relation(fields: [characterId], references: [id])

  // Source tracking (for personas/twins)
  generationMethod String  @default("oripheon") // "oripheon" | "persona_import" | "twin_import"
  sourceIdentityId String? // If derived from real identity

  // Consent
  consentToken   String? // Proof of consent for this genome
  consentRecords ConsentRecord[]

  @@index([name])
  @@index([characterId])
  @@index([sourceIdentityId])
}

// Consent Record - immutable audit trail with hash chain
model ConsentRecord {
  id        String                @id @default(cuid())
  type      ConsentRecordTypeEnum
  timestamp DateTime              @default(now())

  // Hash chain for tamper-proof audit trail
  previousHash String? // SHA256 of previous record
  hash         String // SHA256 of this record

  // Source of consent
  source    String // "user" | "o8" | "starforge" | "sembla" | "api"
  sourceId  String? // ID from external system
  grantedBy String? // Email or user ID who granted

  // What was consented to
  permissions Json // { synthesis: bool, training: bool, commercial: bool, ... }
  terms       String? // Link to terms accepted
  metadata    Json    @default("{}")

  // Relations (a record belongs to one of these)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  voiceProfileId String?
  voiceProfile   VoiceProfile? @relation(fields: [voiceProfileId], references: [id], onDelete: Cascade)

  licenseId String?
  license   License? @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  genomeId String?
  genome   CharacterGenome? @relation(fields: [genomeId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([voiceProfileId])
  @@index([licenseId])
  @@index([genomeId])
  @@index([timestamp])
  @@index([hash])
}

// Invite Code System for Exclusivity Gate
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique // e.g., "SEMBLA-ELITE-2026"
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  maxUses     Int       @default(1)
  currentUses Int       @default(0)
  isActive    Boolean   @default(true)

  // Who created this code
  createdBy String? // Admin email or "system"

  // Metadata
  tier  String  @default("registry") // "registry" | "pro" | "legacy"
  notes String?

  // Track who used it
  usedBy InviteCodeUsage[]

  @@index([code])
  @@index([isActive])
}

model InviteCodeUsage {
  id           String     @id @default(cuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  usedAt       DateTime   @default(now())
  usedByEmail  String
  characterId  String? // Link to created persona

  @@index([inviteCodeId])
  @@index([usedByEmail])
}

// Waitlist for those without invite codes
model WaitlistRequest {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  instagram  String? // For verification
  agency     String? // Agency representation
  reason     String? // Why they want access
  createdAt  DateTime  @default(now())
  status     String    @default("pending") // "pending" | "approved" | "rejected"
  reviewedAt DateTime?
  reviewedBy String?
  notes      String?

  // If approved, which invite code was sent
  inviteCodeSent String?

  @@index([status])
  @@index([createdAt])
}

// CohortPhrase
//
// Cohort-invented language captured with provenance. Source: voice
// samples + authored material. Status path: proposed → active →
// promoted (moves to Ibis frontier zone) or revoked. Per
// docs/slang-cohort.md this is the in-Bóveda half of the slang
// MOAT; the other half is Ibis temporal-dictionary read by
// ibis-slang.ts. Active CohortPhrases surface as embrace
// candidates in the tick + realign system prompt.
//
// Why this is its own model and not a JSON field on Character:
// phrases need cross-character provenance (one phrase from
// contributor X used by characters A, B, C), royalty event
// targeting, lineage indexing, and lifecycle independent of any
// single character.
model CohortPhrase {
  id                String     @id @default(cuid())
  phrase            String
  // The character that originated the phrase (provenance head).
  // Multi-character LoRA-tied attribution is deferred; for now
  // first-extraction wins.
  sourceCharacterId String?
  sourceCharacter   Character? @relation(fields: [sourceCharacterId], references: [id], onDelete: SetNull)
  // The lineage(s) this phrase is rooted in. Single string for v1
  // (e.g. "yoruba_diaspora_uk"); future: array.
  lineage           String?
  // Subtaste designation code (S-0, L-3, etc.) when known. Used
  // for filtering embrace candidates by Subtaste affinity.
  subtasteCode      String?
  // Source evidence: which voice sample / authored line surfaced
  // it. Stored as raw substring for auditability.
  sourceQuote       String?
  // Optional human-friendly gloss explaining the phrase to
  // cultural advisors during review.
  gloss             String?
  // Lifecycle. proposed = freshly extracted, awaiting review.
  // active = visible to embrace lists. promoted = sent to Ibis
  // frontier (write-back, deferred). revoked = contributor
  // pulled it back per right-to-forget.
  status            String     @default("proposed")
  // Times this phrase has been embraced in generations. Will tie
  // to Imperium royalty when the cohort LoRA pipeline ships.
  useCount          Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([phrase, sourceCharacterId])
  @@index([status])
  @@index([lineage])
  @@index([subtasteCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cipher: encoded handle to a moment of significance in the world.
// Generated server-side when player presence, sparks, or atmospheric events
// produce significant moments. Surfaces to UE as a collectible cryptic glyph
// that decodes over time as the player meets unlock conditions.
// ─────────────────────────────────────────────────────────────────────────────

model Cipher {
  id        String @id // hex like "0x3F7A"
  signature String // glyph: Λ Δ Π ◬ ⬡ ⟁ Σ Ω
  rarity    String @default("common") // common|rare|sigil
  state     String @default("locked") // locked|partial|unlocked
  kind      String // encounter|witness|threshold

  // What anchored this cipher in the world
  sourceCharacterId  String?
  sourceCharacter    Character? @relation("CipherSourceCharacter", fields: [sourceCharacterId], references: [id], onDelete: SetNull)
  sourceLocationName String?
  sourceLocation     Location?  @relation(fields: [sourceLocationName], references: [name], onDelete: SetNull)
  sourceEpisodeId    String?

  // Unlock condition
  unlockType  String // presence_count|dialogue_count|spark_count|combo
  unlockValue Int    @default(1)

  // Payloads
  payloadLocked   String // cryptic placeholder visible while locked
  payloadUnlocked String // the real reveal
  payloadHint     String? // optional hint shown when locked

  createdAt  DateTime  @default(now())
  unlockedAt DateTime?

  progress CipherProgress[]

  @@index([sourceCharacterId])
  @@index([sourceLocationName])
  @@index([kind])
  @@index([state])
}

model CipherProgress {
  // Composite key: each player has at most one progress row per cipher.
  playerId     String
  cipherId     String
  cipher       Cipher   @relation(fields: [cipherId], references: [id], onDelete: Cascade)
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([playerId, cipherId])
  @@index([playerId])
}

// Player presence at a place (UE volume trigger reports). Drives the
// presence_count unlock condition, also surfaces in the trail.
model PresenceEvent {
  id           String   @id @default(cuid())
  playerId     String
  characterId  String? // when player approached a specific character
  locationName String?
  kind         String   @default("approached") // approached|departed|listened
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([playerId, characterId])
  @@index([playerId, locationName])
  @@index([createdAt])
}
